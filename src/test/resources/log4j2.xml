<?xml version="1.0" encoding="UTF-8"?>
<!--
  Two appenders on purpose:
    Console  -> shows up in the Jenkins build console output
    File     -> target/logs/automation.log, archived as a build artifact
  %X{test} is the MDC value put by TestListener.onTestStart, so parallel
  threads stay readable ("which test printed this line?").
-->
<Configuration status="WARN">
  <Properties>
    <Property name="PATTERN">%d{HH:mm:ss.SSS} %-5level [%X{test}] %logger{1} - %msg%n</Property>
    <Property name="LOG_DIR">target/logs</Property>
  </Properties>

  <Appenders>
    <Console name="Console" target="SYSTEM_OUT">
      <PatternLayout pattern="${PATTERN}"/>
    </Console>

    <File name="File" fileName="${LOG_DIR}/automation.log" append="false">
      <PatternLayout pattern="${PATTERN}"/>
    </File>
  </Appenders>

  <Loggers>
    <Logger name="com.mot" level="DEBUG" additivity="false">
      <AppenderRef ref="Console"/>
      <AppenderRef ref="File"/>
    </Logger>

    <Root level="WARN">
      <AppenderRef ref="Console"/>
      <AppenderRef ref="File"/>
    </Root>
  </Loggers>
</Configuration>
