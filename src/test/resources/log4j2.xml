<?xml version="1.0" encoding="UTF-8"?>
<!--
  Two places every log line goes:
    Console -> shows up in the Jenkins build console output
    File    -> target/logs/automation.log, archived as a Jenkins artifact
-->
<Configuration status="WARN">
  <Properties>
    <Property name="PATTERN">%d{HH:mm:ss.SSS} %-5level %msg%n</Property>
  </Properties>

  <Appenders>
    <Console name="Console" target="SYSTEM_OUT">
      <PatternLayout pattern="${PATTERN}"/>
    </Console>

    <File name="File" fileName="target/logs/automation.log" append="false">
      <PatternLayout pattern="${PATTERN}"/>
    </File>
  </Appenders>

  <Loggers>
    <!-- "test" is the logger name used by Log.java -->
    <Logger name="test" level="INFO" additivity="false">
      <AppenderRef ref="Console"/>
      <AppenderRef ref="File"/>
    </Logger>

    <!-- everything else stays quiet unless something goes wrong -->
    <Root level="WARN">
      <AppenderRef ref="Console"/>
      <AppenderRef ref="File"/>
    </Root>
  </Loggers>
</Configuration>
