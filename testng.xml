<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<!--
  The suite definition Surefire runs (see <suiteXmlFile> in pom.xml).

  parallel="methods" + thread-count: each test method runs on its own thread.
  This is safe here because DriverManager keeps the Playwright objects in
  ThreadLocals and every method gets a fresh BrowserContext.

  The listener is registered once, here, which is what keeps reporting out of
  the test code.
-->
<suite name="MinistryOfTesting Regression Suite" verbose="1" parallel="methods" thread-count="2">

  <listeners>
    <listener class-name="com.mot.listeners.TestListener"/>
  </listeners>

  <test name="Club Search">
    <classes>
      <class name="com.mot.tests.SearchSkillsTest"/>
    </classes>
  </test>

</suite>
