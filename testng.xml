<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<!--
  The suite Maven runs (wired up by <suiteXmlFile> in pom.xml).

  Two jobs:
    1. register the listener ONCE, which is what keeps reporting code out of
       the tests
    2. list the test classes to run

  Tests run one at a time. Adding parallel="methods" thread-count="2" here would
  run them at the same time, but then the browser fields in BaseTest and the
  report fields in ExtentReport would all need to be ThreadLocal.
-->
<suite name="MinistryOfTesting Suite" verbose="1">

  <listeners>
    <listener class-name="com.mot.TestListener"/>
  </listeners>

  <test name="Club Search">
    <classes>
      <class name="com.mot.SearchSkillsTest"/>
    </classes>
  </test>

</suite>
